    },
    "A reverse-charge invoice must print your UID alongside the client's.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Rechnung mit Reverse Charge muss Ihre UID neben derjenigen des Kunden ausweisen."
