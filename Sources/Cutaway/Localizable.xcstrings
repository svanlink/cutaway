        }
      }
    },
    "A session has to end on the day it started. Add a second one after midnight.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Sitzung muss an dem Tag enden, an dem sie begonnen hat. Trage nach Mitternacht eine zweite ein."
