{"nodes": [{"id": "docs_research_2026_09_05_detection_intelligence_detecting_work_and_projects_report", "label": "Detecting work and projects report", "file_type": "document", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_detection_intelligence_accessibility_permission", "label": "Accessibility permission", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All strong trackers need it to read window titles; Apple's own alert says the app can control your Mac, so the in-app explanation must pre-empt that; prompt suppressed for sandboxed apps."}, {"id": "docs_research_2026_09_05_detection_intelligence_automation_permission", "label": "Automation permission", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One per-app prompt for AppleScript document paths; RescueTime stresses it does not give control of your computer."}, {"id": "docs_research_2026_09_05_detection_intelligence_screen_recording_permission", "label": "Screen Recording permission", "file_type": "rationale", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gates kCGWindowName since 10.15, triggers Sequoia's monthly re-consent, being pushed to ScreenCaptureKit; Timing and Rize keep it opt-in; refuse as a default path."}, {"id": "docs_research_2026_09_05_detection_intelligence_axobserver_notifications", "label": "AXObserver notifications", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AXObserverAddNotification on kAXFocusedWindowChanged and kAXTitleChanged replaces title polling; Karabiner re-subscribes on every focus change."}, {"id": "docs_research_2026_09_05_detection_intelligence_nsworkspace_activation_notifications", "label": "NSWorkspace activation notifications", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_detection_intelligence_resolve_tier_1_tier_2_detection", "label": "Resolve Tier 1 / Tier 2 detection", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tier 1 scripting API is Studio-only since 19.1; Tier 2 window title with Accessibility; Cutaway's split is right."}, {"id": "docs_research_2026_09_05_detection_intelligence_resolve_scripting_studio_only_gate", "label": "Resolve scripting Studio-only gate", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_detection_intelligence_fuscript", "label": "fuscript", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_detection_intelligence_getprojectattributesincurrentfolder", "label": "GetProjectAttributesInCurrentFolder", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_detection_intelligence_after_effects_doscript_route", "label": "After Effects DoScript route", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DoScript into app.project.file; null if unsaved; title suffix * when dirty."}, {"id": "docs_research_2026_09_05_detection_intelligence_photoshop_applescript_route", "label": "Photoshop AppleScript route", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_detection_intelligence_illustrator_applescript_route", "label": "Illustrator AppleScript route", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_detection_intelligence_indesign_applescript_route", "label": "InDesign AppleScript route", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_detection_intelligence_premiere_pro_no_route", "label": "Premiere Pro no route", "file_type": "rationale", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dictionary holds only capture and editoriginal; title hidden from Accessibility; only a UXP/CEP panel or Screen Recording reaches it."}, {"id": "docs_research_2026_09_05_detection_intelligence_final_cut_pro_read_only_dictionary", "label": "Final Cut Pro read-only dictionary", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_detection_intelligence_idle_threshold_defaults", "label": "Idle threshold defaults", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timing 3, ActivityWatch 3, RescueTime 5, Rize 5 minutes; idle counts from last input so the stretch is removed retroactively."}, {"id": "docs_research_2026_09_05_detection_intelligence_display_sleep_assertion_presence_rule", "label": "Display-sleep assertion presence rule", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Apps holding kIOPMAssertionTypePreventUserIdleDisplaySleep (players, meeting apps) are visible system-wide; Timing turns idle detection off when the frontmost app prevents the screen going dark."}, {"id": "docs_research_2026_09_05_detection_intelligence_prompt_floor_and_ceiling", "label": "Prompt floor and ceiling", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timing asks only after 5 min and never after 10 h; focus returns to the previous app."}, {"id": "docs_research_2026_09_05_detection_intelligence_rule_based_matching_with_dwell", "label": "Rule-based matching with dwell", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timemator rules carry a dwell time to prevent false triggering; Timing offers a title-contains rule on project creation."}, {"id": "docs_research_2026_09_05_detection_intelligence_activitywatch", "label": "ActivityWatch", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_detection_intelligence_qbserve", "label": "Qbserve", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_detection_intelligence_timing", "label": "Timing", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_detection_intelligence_rescuetime", "label": "RescueTime", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_detection_intelligence_rize", "label": "Rize", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_detection_intelligence_timemator", "label": "Timemator", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_detection_intelligence_toggl_track", "label": "Toggl Track", "file_type": "concept", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_detection_intelligence_projectdetector", "label": "ProjectDetector", "file_type": "code", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_detection_intelligence_rec_event_driven_loop", "label": "Rec: Event-driven loop", "file_type": "rationale", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep the 1 Hz permission-free idle read; app switches via didActivateApplicationNotification; Resolve titles via AXObserver with 5 s poll fallback. Effort M, no new permission."}, {"id": "docs_research_2026_09_05_detection_intelligence_rec_adobe_project_names_via_applescript", "label": "Rec: Adobe project names via AppleScript", "file_type": "rationale", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AE DoScript, PS/AI name of current document, InDesign full name of document 1; query on activation only and cache. Effort M; new Automation prompt per app."}, {"id": "docs_research_2026_09_05_detection_intelligence_rec_skip_premiere_pro_and_say_so", "label": "Rec: Skip Premiere Pro and say so", "file_type": "rationale", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Empty dictionary, title hidden from AX; a UXP panel is L; Screen Recording brings Sequoia's monthly nag. Effort S."}, {"id": "docs_research_2026_09_05_detection_intelligence_rec_display_sleep_assertion_exemption", "label": "Rec: Display-sleep-assertion exemption", "file_type": "rationale", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When input goes stale treat the user as present if the frontmost anchor holds PreventUserIdleDisplaySleep; cheaper than the >50% CPU heuristic; keep the 30-min cap. Effort S."}, {"id": "docs_research_2026_09_05_detection_intelligence_rec_prompt_floor_and_ceiling", "label": "Rec: Prompt floor and ceiling", "file_type": "rationale", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never ask under 5 min or after 10 h; return focus on dismiss. Effort S."}, {"id": "docs_research_2026_09_05_detection_intelligence_rec_resolve_tier_1_polish", "label": "Rec: Resolve Tier 1 polish", "file_type": "rationale", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use 21.0.3's GetProjectAttributesInCurrentFolder to list projects without opening; gate spawns on scriptapp non-None. Effort S, Studio only."}, {"id": "docs_research_2026_09_05_detection_intelligence_rec_rule_based_matching", "label": "Rec: Rule-based matching", "file_type": "rationale", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Title/path rules with Timemator-style dwell; offer a rule on project creation. Effort M."}, {"id": "docs_research_2026_09_05_detection_intelligence_rec_permission_copy_audit", "label": "Rec: Permission copy audit", "file_type": "rationale", "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accessibility = reads window titles, never controls your Mac; Automation = per-app project name; never Screen Recording, never keystrokes, nothing leaves your Mac. Effort S."}], "edges": [{"source": "docs_research_2026_09_05_detection_intelligence_detecting_work_and_projects_report", "target": "docs_research_2026_09_05_detection_intelligence_accessibility_permission", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_2026_09_05_detection_intelligence_detecting_work_and_projects_report", "target": "docs_research_2026_09_05_detection_intelligence_automation_permission", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_2026_09_05_detection_intelligence_detecting_work_and_projects_report", "target": "docs_research_2026_09_05_detection_intelligence_screen_recording_permission", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_2026_09_05_detection_intelligence_detecting_work_and_projects_report", "target": "docs_research_2026_09_05_detection_intelligence_axobserver_notifications", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/research/2026-09-05-detection-intelligence.md", "source_location": null, "weight": 1.0}, {"source": "docs_research_2026_09_05_detection_intelligence_detecting_work_and_projects_report", "target": "docs_research_2026_09_05_detection_intelligence_nsworkspace_activation_notifications", "relat