{"nodes": [{"id": "docs_research_2026_09_05_billing_invoicing_billing_for_freelance_editors_report", "label": "Billing for freelance editors report", "file_type": "document", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_billing_invoicing_day_rate", "label": "Day rate", "file_type": "concept", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Post-production day = 10 h, 1.5x after 8 h, 2x after 12; IATSE Local 700 sets 8 h minimum."}, {"id": "docs_research_2026_09_05_billing_invoicing_minimum_billing_units", "label": "Minimum billing units", "file_type": "concept", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "4-hour minimum is standard for hourly gigs; half days up to 4 h."}, {"id": "docs_research_2026_09_05_billing_invoicing_per_entry_rounding_raw_kept", "label": "Per-entry rounding raw kept", "file_type": "concept", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Harvest/Toggl/EARLY round per entry before totalling and keep the exact value; rounding is a tool setting, not an editor norm."}, {"id": "docs_research_2026_09_05_billing_invoicing_unbilled_view", "label": "Unbilled view", "file_type": "concept", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_billing_invoicing_billing_status", "label": "Billing status", "file_type": "concept", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timing: Not billable / Billable / Billed / Paid; Bonsai: Non-billable / Unbilled / Billed."}, {"id": "docs_research_2026_09_05_billing_invoicing_lock_on_invoice", "label": "Lock on invoice", "file_type": "concept", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entries locked once invoiced; deleting the invoice unmarks them (Harvest, Clockify)."}, {"id": "docs_research_2026_09_05_billing_invoicing_art_26_mwstg_invoice_fields", "label": "Art. 26 MWSTG invoice fields", "file_type": "concept", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Swiss VAT Act mandatory fields: supplier name/location with VAT number, recipient, supply period, nature/extent, consideration, rate and tax amount."}, {"id": "docs_research_2026_09_05_billing_invoicing_swiss_vat_threshold", "label": "Swiss VAT threshold", "file_type": "concept", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Liable at CHF 100 000 worldwide turnover; below, no VAT line unless opted in; rates 8.1 / 2.6 / 3.8 %."}, {"id": "docs_research_2026_09_05_billing_invoicing_eu_reverse_charge", "label": "EU reverse charge", "file_type": "concept", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Art. 44/196 services from a non-established supplier: sequential number, both VAT IDs, literal mention Reverse charge."}, {"id": "docs_research_2026_09_05_billing_invoicing_chf_0_05_rounding", "label": "CHF 0.05 rounding", "file_type": "concept", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cash rounds to 5 Rappen; formula x20, round, /20; convention total to 0.05."}, {"id": "docs_research_2026_09_05_billing_invoicing_swiss_qr_bill_ig_2_3", "label": "Swiss QR-bill IG 2.3", "file_type": "concept", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SIX Implementation Guidelines v2.3 since Nov 2025: amount two decimals, CHF/EUR only, structured addresses, 148x105 mm payment part plus 62x105 mm receipt, Helvetica 6-10 pt."}, {"id": "docs_research_2026_09_05_billing_invoicing_six_qr_bill_standard", "label": "SIX QR-bill standard", "file_type": "concept", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_billing_invoicing_swico_s1_billing_information", "label": "Swico S1 billing information", "file_type": "concept", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_billing_invoicing_imagerenderer_to_pdf", "label": "ImageRenderer to PDF", "file_type": "concept", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SwiftUI ImageRenderer into a CGContext PDF keeps text vector with zero dependencies; multi-page by mutating renderer.content per page."}, {"id": "docs_research_2026_09_05_billing_invoicing_dagronf_qrcode_library", "label": "dagronf QRCode library", "file_type": "concept", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_billing_invoicing_harvie", "label": "Harvie", "file_type": "concept", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_billing_invoicing_clockify_rounding_trap", "label": "Clockify rounding trap", "file_type": "rationale", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Invoices round hours to two decimals but reports do not, so 20 min bills $33.00 vs $33.33; totals that disagree are a top complaint."}, {"id": "docs_research_2026_09_05_billing_invoicing_under_billing_honesty_explicit", "label": "Under-billing honesty explicit", "file_type": "rationale", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cutaway never inflates time: rounding opt-in defaulting to nearest or down, raw seconds kept beside the rounded value, manual edits flagged adjusted_hours, minimums and day rates as booked-not-worked lines."}, {"id": "docs_research_2026_09_05_billing_invoicing_invoicing_complaints", "label": "Invoicing complaints", "file_type": "rationale", "source_file": "docs/research/2026-09-05-billing-invoicing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Export-and-rebuild loops, totals that disagree, no invoiced/paid state, lost billable time, pricing shocks; all argue for a local, boring, correct invoice inside Cutaway."}, {"id": "docs_research_2026_09_05_billing_invoi