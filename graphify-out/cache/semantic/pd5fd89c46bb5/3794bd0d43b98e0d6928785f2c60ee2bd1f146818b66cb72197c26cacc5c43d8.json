s so", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Edit day, Add day, pencil on the day, adjusted_hours in the CSV."}, {"id": "readme_local_only_privacy", "label": "Local-only privacy", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No account, no network calls, no telemetry; a SQLite file the user owns."}, {"id": "readme_automatic_backups", "label": "Automatic backups", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every launch, newest 7 kept, skipped when nothing changed."}, {"id": "readme_locale_pinned_formatting", "label": "Locale-pinned formatting", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_idle_threshold", "label": "Idle threshold", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Long unattended renders pause the clock; raise the threshold deliberately."}], "edges": [{"source": "readme_cutaway_readme", "target": "readme_cutaway", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_cutaway_readme", "target": "readme_homebrew_cask_install", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_cutaway_readme", "target": "readme_gatekeeper_ad_hoc_signing_note", "relation": "references", "confidence": "EXTRACTED", "confidence_score"