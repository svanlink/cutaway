rce_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On-device crash and hang diagnostics on macOS 12+; persist MXCrashDiagnostic to disk and show in Settings; no upload needed."}, {"id": "docs_research_2026_09_05_engineering_distribution_nsapplicationcrashonexceptions", "label": "NSApplicationCrashOnExceptions", "file_type": "concept", "source_file": "docs/research/2026-09-05-engineering-distribution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_engineering_distribution_timer_tolerance", "label": "Timer tolerance", "file_type": "concept", "source_file": "docs/research/2026-09-05-engineering-distribution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Apple: at least 10% of the interval; repeating timers do not drift; dispatch_timer_strict should be avoided."}, {"id": "docs_research_2026_09_05_engineering_distribution_nsworkspace_didactivateapplicationnotification", "label": "NSWorkspace didActivateApplicationNotification", "file_type": "concept", "source_file": "docs/research/2026-09-05-engineering-distribution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_engineering_distribution_app_nap", "label": "App Nap", "file_type": "concept", "source_file": "docs/research/2026-09-05-engineering-distribution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_engineering_distribution_cgeventsource_secondssincelasteventtype", "label": "CGEventSource secondsSinceLastEventType", "file_type": "concept", "source_file": "docs/research/2026-09-05-engineering-distribution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": nu