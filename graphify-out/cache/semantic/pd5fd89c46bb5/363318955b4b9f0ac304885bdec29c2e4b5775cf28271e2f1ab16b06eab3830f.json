{"nodes": [{"id": "docs_research_2026_09_05_engineering_distribution_engineering_and_distribution_report", "label": "Engineering and distribution report", "file_type": "document", "source_file": "docs/research/2026-09-05-engineering-distribution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_research_2026_09_05_engineering_distribution_developer_id", "label": "Developer ID", "file_type": "concept", "source_file": "docs/research/2026-09-05-engineering-distribution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "$99/year membership; the only way past Gatekeeper on macOS 15/26 without users lowering security; also stabilises TCC grants across rebuilds."}, {"id": "docs_research_2026_09_05_engineering_distribution_notarization", "label": "Notarization", "file_type": "concept", "source_file": "docs/research/2026-09-05-engineering-distribution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automated malware scan, not App Review; notarytool submit --wait then stapler staple; requires Hardened Runtime."}, {"id": "docs_research_2026_09_05_engineering_distribution_gatekeeper_on_macos_15_and_26", "label": "Gatekeeper on macOS 15 and 26", "file_type": "rationale", "source_file": "docs/research/2026-09-05-engineering-distribution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Since macOS 15 the right-click Open bypass is gone; on 26 an ad-hoc-signed quarantined app is sent to the Trash unless Gatekeeper is set to Anywhere. Homebrew casks drop quarantine, GitHub zips do not."}, {"id": "docs_research_2026_09_05_engineering_distribution_hardened_runtime", "label": "Hardened Runtime", "file_type": "concept", "source_file": "docs/research/2026-09-05-engineering-distribution.md", "source_loca