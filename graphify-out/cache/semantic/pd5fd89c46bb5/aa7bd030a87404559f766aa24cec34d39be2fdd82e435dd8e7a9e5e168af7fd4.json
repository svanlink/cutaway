: null, "contributor": null}, {"id": "docs_research_2026_09_05_competitors_premium_ux_perpetual_fallback_license", "label": "Perpetual fallback license", "file_type": "rationale", "source_file": "docs/research/2026-09-05-competitors-premium-ux.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pay once, 12 months of updates, keep the last version forever; DEVONthink, Tinkerwell, BoltAI use it; Paddle calls it the Dutch model. Accepted where subscriptions for local-only utilities draw backlash."}, {"id": "docs_research_2026_09_05_competitors_premium_ux_subscription_backlash", "label": "Subscription backlash", "file_type": "rationale", "source_file": "docs/research/2026-09-05-competitors-premium-ux.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every subscription conversion in this category (Tyme 2 to 3, Timing) produced 1-star reviews; r/macapps asks for native pay-once trackers; acceptable one-time price is at most one year of subscription."}, {"id": "docs_research_2026_09_05_competitors_premium_ux_permission_primer_pattern", "label": "Permission primer pattern", "file_type": "rationale", "source_file": "docs/research/2026-09-05-competitors-premium-ux.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Premium apps explain each permission with one concrete reason before prompting, because a denied prompt cannot be re-requested; Timing names Premiere as the reason for Screen Recording."}, {"id": "docs_research_2026_09_05_competitors_premium_ux_start_tracking_immediately", "label": "Start tracking immediately", "file_type": "rationale", "source_file": "docs/research/2026-09-05-competitors-premium-ux.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rize, Timely, Toggl, Build Mode start tracking within minutes and defer configuration; no competitor ships sample data."}, {"id": "docs_research_2026_09_05_competitors_premium_ux_rec_day_timeline_in_stats", "label": "Rec: Day timeline in Stats", "file_type": "rationale", "source_file": "docs/research/2026-09-05-competitors-premium-ux.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Present in 9/10 competitors; the thing that makes 'left the timer on during lunch' visible and fixable; Timing's retention hook. Effort M."}, {"id": "docs_research_2026_09_05_competitors_premium_ux_rec_return_from_idle_prompt", "label": "Rec: Return-from-idle prompt", "file_type": "rationale", "source_file": "docs/research/2026-09-05-competitors-premium-ux.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reviewers call the away-time prompt the single feature that sold them on Timemator and Klokki; fits under-billing rule if default = drop. Effort S."}, {"id": "docs_research_2026_09_05_competitors_premium_ux_rec_pdf_project_report", "label": "Rec: PDF project report", "file_type": "rationale", "source_file": "docs/research/2026-09-05-competitors-premium-ux.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "8/10 competitors export PDF; CSV-only reads unfinished for invoicing. Effort M."}, {"id": "docs_research_2026_09_05_competitors_premium_ux_rec_client_layer_and_session_notes", "label": "Rec: Client layer and session notes", "file_type": "rationale", "source_file": "docs/research/2026-09-05-competitors-premium-ux.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "8/10 have both; Rize marked down for a bolt-on client layer; Tyme users complain about clunky notes. Effort M."}, {"id": "docs_research_2026_09_05_competitors_premium_ux_rec_global_hotkey_and_shortcuts_actions", "label": "Rec: Global hotkey and Shortcuts actions", "file_type": "rationale", "source_file": "docs/research/2026-09-05-competitors-premium-ux.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keyboard control is the most-praised Mac-native trait (Timery, Tyme, Timing). Effort S."}, {"id": "docs_research_2026_09_05_competitors_premium_ux_rec_developer_id_and_notarisation_before_paid_release", "label": "Rec: Developer ID and notarisation before paid release", "file_type": "rationale", "source_file": "docs/research/2026-09-05-competitors-premium-ux.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ad-hoc signing drops Accessibility/Screen Recording grants on rebuild and blocks Gatekeeper for most buyers. Effort S, $99."}, {"id": "docs_research_2026_09_05_competitors_premium_ux_rec_permissions_primer_window", "label": "Rec: Permissions primer window", "file_type": "rationale", "source_file": "docs/research/2026-09-05-competitors-premium-ux.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One row per permission with the concrete reason and live status after returning from System Settings; explain-before-prompt is best practice. Effort S."}, {"id": "docs_research_2026_09_05_competitors_premium_ux_rec_one_time_price_39_49_with_perpetual_fallback", "label": "Rec: One-time price 39-49 with perpetual fallback", "file_type": "rationale", "source_file": "docs/research/2026-09-05-competitors-premium-ux.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matches Timemator/Timex/DEVONthink norms and r/macapps demand; Setapp's hybrid recommendation; every subscription conversion drew 1-star reviews. Effort S."}, {"id": "docs_research_2026_09_05_competitors_premium_ux_rec_desktop_widget", "label": "Rec: Desktop widget", "file_type": "rationale", "source_file": "docs/research/2026-09-05-competitors-premium-ux.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tyme, Timery, Hours, Rize ship one; MacStories rates Timery's widgets its best feature. Effort M."}, {"id": "docs_research_2026_09_05_competitors_premium_ux_rec_rounding_rules_per_project", "label": "Rec: Rounding rules per project", "file_type": "rationale", "source_file": "docs/research/2026-09-05-competitors-premium-ux.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hours, Toggl, Timemator, Tyme offer it; always down to honour under-billing. Effort S."}, {"id": "docs_research_2026_09_05_competitors_premium_ux_not_recommended_icloud_sync", "label": "Not recommended: iCloud sync", "file_type": "rationale", "source_file": "docs/research/2026-09-05-competitors-premium-ux.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contradicts no-network positioning; Timemator's top crash complaint."}, {"id": "docs_research_2026_09_05_competitors_premium_ux_not_recommended_pomodoro_coaching", "label": "Not recommended: Pomodoro coaching", "file_type": "rationale", "source_file": "docs/research/2026-09-05-competitors-premium-ux.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Off-brand."}, {"id": "docs_research_2026_09_05_competitors_premium_ux_not_recommended_native_invoicing", "label": "Not recommended: native invoicing", "file_type": "rationale", "source_file": "docs/research/2026-09-05-competitors-premium-ux.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Harvest's moat."}], "edges": [{"source": "docs_research_2026_09_05_competito